# ══════════════════════════════════════════════════════════════
# Open WebUI 独立部署配置（复制为 .env 后按需修改）
#   cp deploy/.env.example deploy/.env && vi deploy/.env
# ══════════════════════════════════════════════════════════════

# ── 镜像（由 deploy/build.sh 构建并推送）──────────────────────
OPEN_WEBUI_IMAGE=registry.cn-shanghai.aliyuncs.com/daxia-hermer/open-webui:scm-custom-20261109

# ── 对接 Hermes api_server（OpenAI 兼容端点）───────────────────
# multiplex 下只有一个监听器（容器内 8642），宿主映射绑 docker0 网关 172.17.0.1。
# 各 profile 靠 /p/<profile>/v1 前缀区分，key 用各 profile 的 API_SERVER_KEY。
# 跨机部署：http://<hermes服务器IP>:8642/p/<profile>/v1（需 hermes 侧改 HERMES_API_BIND）
HERMES_API_BASE_URL=http://172.17.0.1:8642/p/scm/v1

# 多 profile 接入方式（Open WebUI 管理界面 Admin → Settings → Connections 加多条）：
#   http://172.17.0.1:8642/p/scm/v1               + scm 的 API_SERVER_KEY  → 模型名 scm
#   http://172.17.0.1:8642/p/hr/v1                + hr 的 key              → 模型名 hr
#   http://172.17.0.1:8642/p/fin/v1               + fin 的 key             → 模型名 fin
#   http://172.17.0.1:8642/p/hr_annual_leave/v1   + 对应 key               → hr_annual_leave
#   http://172.17.0.1:8642/p/sales/v1             + 对应 key               → sales
# 端口都是 8642，只有前缀和 key 不同；切模型 = 切 profile
# 用户身份：容器已开 ENABLE_FORWARD_USER_INFO_HEADERS，上游会收到 X-OpenWebUI-User-Email

# Bearer 密钥：与 Hermes 侧 profiles/scm/.env 的 API_SERVER_KEY 保持一致
HERMES_API_KEY=

# ── 容器 ─────────────────────────────────────────────────────
# 只绑本机回环，公网由 nginx 反代
OPEN_WEBUI_PORT=8690
OPEN_WEBUI_DATA_DIR=/var/deploy/open-webui/data

# ── 账号策略 ─────────────────────────────────────────────────
# 是否允许自助注册（false = 仅管理员在后台建号/邀请）
ENABLE_SIGNUP=true

# ── 域名 / nginx ─────────────────────────────────────────────
DOMAIN=ai.daxiazhaoguang.com
# 申请 Let's Encrypt 证书时用的邮箱（留空则跳过 HTTPS 申请）
LETSENCRYPT_EMAIL=

# ── 镜像仓库登录（推送/拉取私有镜像用）─────────────────────────
ACR_REGISTRY=registry.cn-shanghai.aliyuncs.com
ACR_USERNAME=docker@1335952755537533
ACR_PASSWORD=
